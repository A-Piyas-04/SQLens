# Frontend API base override (optional).
# Leave empty so the browser calls same-origin /api (Vite proxies in dev; Vercel serverless in prod).
# Local Express backend without Docker: http://localhost:3001
# VITE_API_URL=http://localhost:3001
VITE_API_URL=

# Docker Compose only — Vite dev server proxies /api to this target (not used in the browser).
# VITE_API_PROXY_TARGET=http://backend:3001

# Every VITE_* value is bundled into public client JavaScript.
# Never add VITE_GEMINI_API_KEY or any other secret here.

# ── Vercel serverless (/api) — set these in the Vercel project, not in VITE_* ──
# Master switch for every AI route. Anything other than "true" makes /api/* return 404.
# AI_FEATURES_ENABLED=false
#
# GEMINI_API_KEY=            # dedicated production key, server-only
# GEMINI_MODEL=gemini-2.0-flash-lite
# GEMINI_MAX_OUTPUT_TOKENS=1024
#
# Shared rate-limit store (Upstash Redis or Vercel KV REST credentials).
# Without these, limits fall back to per-instance memory and are not global.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# AI_RATE_LIMIT_MAX=10
# AI_RATE_LIMIT_WINDOW_MS=60000
# AI_BURST_LIMIT_MAX=3
# AI_BURST_LIMIT_WINDOW_MS=10000
# AI_DAILY_REQUEST_LIMIT=5000
#
# ENABLE_LEGACY_GENERATE_SQL=false
