# Frontend API base override (optional).
# Leave empty so the browser calls same-origin /api (Vite proxies in dev; Vercel serverless in prod).
# Local Express backend without Docker: http://localhost:3001
# VITE_API_URL=http://localhost:3001
VITE_API_URL=

# Docker Compose only — Vite dev server proxies /api to this target (not used in the browser).
# VITE_API_PROXY_TARGET=http://backend:3001
