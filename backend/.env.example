GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-2.0-flash-lite
# Optional — override fallback order (tried left-to-right after GEMINI_MODEL fails):
# GEMINI_MODEL_FALLBACKS=gemini-2.0-flash,gemini-2.5-flash-lite,gemini-2.5-flash

# Required in production: allow only your deployed frontend origins.
# Example:
# ALLOWED_ORIGINS=https://sqlens.vercel.app,https://www.sqlens.app
ALLOWED_ORIGINS=http://localhost:5173

# Basic per-IP limiter for /api routes
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=15
