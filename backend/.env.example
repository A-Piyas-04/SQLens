GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-2.0-flash-lite
# Optional — override fallback order (tried left-to-right after GEMINI_MODEL fails):
# GEMINI_MODEL_FALLBACKS=gemini-2.0-flash,gemini-2.5-flash-lite,gemini-2.5-flash
# Upper bound on tutor answer length (default 1024).
# GEMINI_MAX_OUTPUT_TOKENS=1024

# Required in production: allow only your deployed frontend origins.
# Example:
# ALLOWED_ORIGINS=https://sqlens.vercel.app,https://www.sqlens.app
ALLOWED_ORIGINS=http://localhost:5173

# Per-client AI limits (normal window + short burst window)
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=60000
AI_BURST_LIMIT_MAX=3
AI_BURST_LIMIT_WINDOW_MS=10000

# Backend-wide ceiling on Gemini calls per UTC day
AI_DAILY_REQUEST_LIMIT=5000

# Legacy /api/generate-sql is disabled when NODE_ENV=production unless this is "true".
# ENABLE_LEGACY_GENERATE_SQL=false

# Never expose this backend publicly with NODE_ENV=development (CORS allows any origin).
